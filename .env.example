# 이 파일을 복사해 .env 로 만들고 실제 값을 채우세요.
# .env 는 .gitignore 대상이어야 합니다 (커밋 금지).

DB_PASSWORD=change-me
JWT_SECRET=change-me-to-a-long-random-string

# AWS SQS 사용 시에만 채우기
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# 소셜 로그인(구글) — Google Cloud Console에서 발급 (커밋 금지)
# 프론트는 frontend/.env 의 VITE_GOOGLE_CLIENT_ID 에 client_id 를 따로 넣는다.
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# MinIO(파일 업로드). docker-compose.yml의 minio 서비스 기본값(minioadmin/minioadmin)과
# 반드시 같은 값을 써야 한다 — 안 맞으면 백엔드가 빈 값으로 붙어 인증에 실패한다.
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# GitHub 연동(잔디) — GitHub > Settings > Developer settings > OAuth Apps 에서 발급 (커밋 금지)
# 콜백을 백엔드가 받으므로 client_id·scope·state를 전부 서버가 조립한다.
# 구글과 달리 프론트에 넣을 값이 없다(VITE_GITHUB_CLIENT_ID 같은 건 필요 없음).
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
# GitHub access token 암호화 키 (Base64 32바이트). 생성: openssl rand -base64 32
# ⚠️ 바꾸면 저장된 토큰을 복호화할 수 없어 전 사용자 재연동이 필요하다.
GITHUB_TOKEN_ENC_KEY=
# GitHub OAuth App에 등록한 Authorization callback URL과 문자 하나까지 같아야 한다.
OAUTH_GITHUB_REDIRECT_URI=https://i15e204.p.ssafy.io/api/github/callback
# 연동을 마친 뒤 사용자를 되돌려 보낼 프론트 주소 (뒤에 /users/{userId} 가 붙는다)
APP_FRONT_BASE_URL=https://i15e204.p.ssafy.io

# 프로젝트 요약(게시물 GitHub README → 구조화 요약) — 커밋 금지
# SSAFY GMS 키를 넣는다(OpenAI 직접 발급 키 아님).
# 비워두면 요약을 만들지 않고 게시물만 저장된다.
OPENAI_API_KEY=
# 모델. 게시물마다 호출되므로 비용이 누적된다.
OPENAI_MODEL=gpt-5.5

# 저장소 정보(README·언어) 조회용 서버 GitHub 토큰.
# GitHub > Settings > Developer settings > Personal access tokens 에서 발급.
# public repo 읽기 권한만 있으면 된다. 비워두면 시간당 60회 제한에 걸린다.
GITHUB_API_TOKEN=
