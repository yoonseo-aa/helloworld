# 이 파일을 복사해 application-local.yml 로 만들어 실제 값을 채운다.
# application-local.yml 은 .gitignore 대상 (민감정보 커밋 금지).
spring:
  datasource:
    url: jdbc:mysql://localhost:3306/helloworld?serverTimezone=UTC&characterEncoding=UTF-8
    username: root
    password: your-local-db-password
    driver-class-name: com.mysql.cj.jdbc.Driver

  data:
    redis:
      host: localhost
      port: 6379

jwt:
  secret: local-dev-secret-please-change-this-to-a-long-random-string

# 비밀번호 재설정 메일(Gmail SMTP).
#  - 로컬 개발은 보통 발송 없이(app.mail.enabled=false, 기본) 링크를 로그로 확인하면 된다.
#  - 실제 발송을 테스트하려면 아래를 채우고 app.mail.enabled=true 로.
#    username=Gmail 주소, password=앱 비밀번호 16자리(2FA 켠 뒤 발급, 공백 제거).
spring.mail:
  username: your-demo@gmail.com
  password: your-16-char-app-password
app:
  mail:
    enabled: false

# AWS SQS
# 로컬은 ElasticMQ 사용(무료, SQS 호환):
#   docker run -d --name helloworld-elasticmq -p 9324:9324 -p 9325:9325 softwaremill/elasticmq-native
#   (큐 helloworld-follow-events / helloworld-post-like-events 는 앱이 자동 생성하거나 elasticmq.conf로 사전 선언)
# credentials는 ElasticMQ에선 아무 값이나 무방(test/test).
spring.cloud.aws:
  region:
    static: ap-northeast-2
  credentials:
    access-key: test
    secret-key: test
  sqs:
    endpoint: http://localhost:9324   # ElasticMQ. 실제 AWS 사용 시 이 줄 제거

# SQS Worker 설정. 팔로우와 좋아요는 스위치가 분리돼 있다 —
# 한쪽을 켠다고 다른 쪽까지 켜지면, 준비 안 된 큐 때문에 기동이 깨질 수 있다.
#
#   ⚠️ 예전에 좋아요 리스너 기본값을 켜짐으로 두고 application.yml에 박아뒀다가,
#      큐·권한이 없는 환경에서 기동 시 CreateQueue 403 → 앱이 아예 안 뜨는 사고가 났다.
#      두 스위치 모두 기본값은 꺼짐이고, 큐가 실제로 준비된 뒤에만 켠다.
#
# 좋아요는 SQS를 켜지 않아도 기능이 완전하다 — 발행에 실패하면 RDB를 동기로 반영한다(폴백).
# 켜면 그 반영이 Worker를 통한 비동기로 바뀔 뿐이다. 팔로우는 폴백이 없어서,
# 끄면 Redis 기반 팔로우만 동작하고 RDB 반영은 일어나지 않는다.
app:
  sqs:
    enabled: true
    follow-queue: helloworld-follow-events
    # ⚠️ 좋아요는 기본 꺼짐(false)이 맞다. 위 경고를 실제로 지키는 값이다.
    #    ElasticMQ를 띄우고 helloworld-post-like-events 큐가 준비된 다음에만 true로 바꾼다.
    #    (elasticmq.conf에 미리 선언돼 있으니 compose로 띄웠다면 이미 존재한다)
    #    꺼도 좋아요는 완전히 동작한다 — RDB는 동기 폴백으로 반영된다.
    post-like:
        enabled: true
        queue: helloworld-post-like-events
    comment-like-queue: comment-like-events
  # 팔로우 1회성 백필. 기본 false(코드 기본값) → 평소엔 둘 필요 없음.
  # SQS를 먼저 켠 뒤 true로 한 번 기동하면 Redis(user:following:*)의 모든 관계를 follows로 옮긴다(멱등).
  # 백필 후에는 반드시 false로 되돌린다(재시작마다 스캔 방지). 운영 서버는 env APP_FOLLOW_BACKFILL_ENABLED 로 주입.
  follow:
    backfill:
      enabled: false



# 소셜 로그인(구글). 구글 클라우드 콘솔에서 발급받은 값을 채운다.
# client-secret은 민감정보 → 실제 값은 절대 커밋 금지(application-local.yml에만, .example엔 placeholder만).
# token-uri / userinfo-uri는 구글 공용 엔드포인트라 그대로 두면 된다.
oauth:
  google:
    client-id: your-google-client-id
    client-secret: your-google-client-secret
    token-uri: https://oauth2.googleapis.com/token
    userinfo-uri: https://www.googleapis.com/oauth2/v3/userinfo

  # GitHub 연동(잔디). GitHub > Settings > Developer settings > OAuth Apps 에서 발급.
  # Authorization callback URL은 프론트 개발 서버 주소로 맞춘다(예: http://localhost:5173/oauth/github).
  # token-encryption-key 생성: openssl rand -base64 32
  github:
    client-id: your-github-client-id
    client-secret: your-github-client-secret
    authorize-uri: https://github.com/login/oauth/authorize
    token-uri: https://github.com/login/oauth/access_token
    graphql-uri: https://api.github.com/graphql
    token-encryption-key: your-base64-encoded-32-byte-key
    # 로컬용 OAuth App의 Authorization callback URL에 이 값을 그대로 등록한다.
    # 3000(프론트)인 이유: vite dev 서버가 /api 를 8080으로 프록시하므로 배포와 같은 구조가 된다.
    redirect-uri: http://localhost:3000/api/github/callback
    scope: read:user repo
    # 연동 후 돌아갈 프론트 주소. vite는 strictPort로 3000 고정이다(5173 아님).
    front-base-url: http://localhost:3000

# 로컬에서 새벽 3시 배치가 도는 게 거슬리면 false로 끈다.
app:
  github:
    sync:
      enabled: true

# Refresh 쿠키: 로컬은 http라서 Secure=true면 브라우저가 쿠키를 저장하지 않는다.
# (Swagger/브라우저에서 /api/auth/reissue·/logout 테스트가 401 나는 원인)
# 배포(HTTPS)에서는 이 블록을 두지 않으면 기본값 secure=true·SameSite=None이 적용된다.
auth:
  refresh-cookie:
    secure: false
    same-site: Lax

# 파일 업로드(MinIO). 로컬에 MinIO가 없으면 업로드 API만 실패하고 나머지 기능은 정상 동작한다.
# 로컬 MinIO 띄우기 (도커):
#   docker run -d --name helloworld-minio-local -p 9000:9000 \
#     -e MINIO_ROOT_USER=minioadmin -e MINIO_ROOT_PASSWORD=minioadmin \
#     quay.io/minio/minio:latest server /data
#   ⚠️ Git Bash에서는 앞에 MSYS_NO_PATHCONV=1 을 붙여야 한다.
#      안 붙이면 /data 가 윈도우 경로로 변환되어 엉뚱한 위치에 저장된다.
#
# 버킷은 앱이 기동할 때 없으면 만들고 공개 읽기 정책까지 적용한다(직접 만들 필요 없음).
# 배포에서는 public-base-url 이 nginx 경로(https://.../files)여야 한다 — MinIO 포트를
# 프론트에 그대로 내려주면 혼합 콘텐츠로 차단된다.
app:
  minio:
    endpoint: http://localhost:9000
    access-key: minioadmin
    secret-key: minioadmin
    bucket: helloworld
    public-base-url: http://localhost:9000/helloworld

# 프로젝트 요약(게시물의 GitHub README → 구조화 요약).
# 키가 없어도 앱은 정상 기동하고, 게시물 작성도 된다 — ai_summary 만 비어 있게 된다.
# 요약 기능을 실제로 만져볼 때만 채우면 된다.
openai:
  # SSAFY GMS 키. base-url 기본값이 이미 GMS 프록시라 따로 안 적어도 된다.
  api-key: <GMS 키>
  model: gpt-5.5

# 저장소 정보 조회용 서버 GitHub 토큰(public repo 읽기 권한만 필요).
# 없으면 익명 호출이라 시간당 60회 제한에 걸린다 — 로컬에서 여러 번 시험하면 금방 막힌다.
github:
  api-token: ghp_...
