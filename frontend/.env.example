# API 모킹 (msw). true면 dev 서버에서 src/mocks/handlers.ts에 정의된 요청만 가로챈다.
# 정의되지 않은 요청은 실서버로 통과(bypass). 프로덕션 빌드에는 msw가 포함되지 않는다.
# 로컬에서 켜려면 .env.local에 VITE_USE_MOCK=true 로 넣는다 (.env* 파일은 커밋 금지).
VITE_USE_MOCK=false

# 구글 OAuth Client ID (Client Secret은 프론트에 절대 두지 않는다 — 백엔드만 보유).
# Google Cloud Console에서 발급, 승인된 리디렉션 URI에 {origin}/oauth/callback/google 등록 필요.
VITE_GOOGLE_CLIENT_ID=
